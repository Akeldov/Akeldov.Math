<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Akeldov.Math.Spatial2D</PackageId>
		<Version>0.6.0</Version>
		<Authors>Stanislav Akeldov</Authors>
		<Copyright>Copyright (c) 2025 Stanislav Akeldov</Copyright>
		<Description>Two-dimensional geometry, vector math, contours, regions, rasterization, spatial sampling, partitioning, and influence field utilities.</Description>
		<PackageReleaseNotes>Added parameterized contour APIs, circular and rectangular contour types, point-based CompositeContour construction, ParameterizedSegmentChain paths, Disk regions, generic GeometryScene raster composition, angle-based Line and ParameterizedLine constructors, directed line side helpers, finite-path normalized coordinates, and ParameterizedSegment shorten/extend helpers. Consolidated raster and color APIs around Raster&lt;T&gt; and RGBA8Bit/RGBA16Bit color namespaces. Breaking changes include GeometryScene layer method renames and Spatial2D type namespace moves for normalized subrectangles, rectangle regions, circular contours, raster encoders, and color types. Expanded curve, contour, region, rasterization, geometry scene, snapshot, fuzz, stress, and benchmark coverage, and refreshed Spatial2D documentation and rendered assets.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>math;geometry;2d;vectors;spatial;curves;contours;regions;rasterization;imaging;sampling;voronoi;poisson-disk</PackageTags>
		<RepositoryUrl>https://github.com/Akeldov/Akeldov.Math</RepositoryUrl>
		<PackageProjectUrl>https://akeldov.github.io/Akeldov.Math/Spatial2D/</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
