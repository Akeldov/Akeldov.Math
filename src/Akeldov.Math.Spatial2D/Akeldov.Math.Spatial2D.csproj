<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>9-recommended</AnalysisLevel>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Akeldov.Math.Spatial2D</PackageId>
		<Version>1.3.0</Version>
		<Authors>Stanislav Akeldov</Authors>
		<Copyright>Copyright (c) 2025 Stanislav Akeldov</Copyright>
		<Description>Two-dimensional geometry and vector math with linear, circular, Bezier, B-spline, and NURBS curves; pairwise curve intersection APIs; contours and regions; rasterization and imaging; spatial sampling and partitioning; and influence fields.</Description>
		<PackageReleaseNotes>Added RasterImageLoader for PNG and BMP loading from files and readable streams. PNG supports 8- and 16-bit grayscale and RGBA, all scanline filters, and Adam7 interlacing. BMP supports uncompressed indexed 8-bit and 32-bit BGRA images, including top-down images. Loaded rasters preserve sample values and use bottom-up Y coordinates; caller streams remain open. PNG export now throws ArgumentOutOfRangeException for non-positive raster dimensions. Existing geometry API signatures are unchanged.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>math;geometry;2d;vectors;spatial;curves;bezier;b-spline;nurbs;contours;regions;rasterization;imaging;perlin-noise;gaussian-blur;sampling;voronoi;delaunay;poisson-disk</PackageTags>
		<RepositoryUrl>https://github.com/Akeldov/Akeldov.Math</RepositoryUrl>
		<PackageProjectUrl>https://akeldov.github.io/Akeldov.Math/Spatial2D/</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.124">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
