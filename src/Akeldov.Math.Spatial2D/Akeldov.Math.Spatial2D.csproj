<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Akeldov.Math.Spatial2D</PackageId>
		<Version>0.4.0</Version>
		<Authors>Stanislav Akeldov</Authors>
		<Copyright>Copyright (c) 2025 Stanislav Akeldov</Copyright>
		<Description>Two-dimensional geometry, vector math, contours, regions, rasterization, spatial sampling, partitioning, and influence field utilities.</Description>
		<PackageReleaseNotes>Added axis-aligned Rectangle, OrientedRectangle, NormalizedSubrectangle, rectangle contour/region conversion, and rectangle-to-oriented conversion APIs. Split region contracts into IRegion and IContourBasedRegion, renamed Region to ContourBasedRegion, and renamed ParametricLine to ParameterizedLine. Hardened arc intersection/tolerance behavior and invariant-culture formatting. Expanded edge-case regression, seeded property/fuzz, and explicit stress coverage for curves, rectangles, regions, Voronoi partitioning, Poisson disk sampling, Delaunay culling, and rasterization. Added linear/circular curve documentation and reproducible local MkDocs setup. Breaking changes: Region is now ContourBasedRegion, ParametricLine is now ParameterizedLine, NormalizedRectanglePart is now NormalizedSubrectangle, and region contracts are split into IRegion/IContourBasedRegion.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>math;geometry;2d;vectors;spatial;curves;contours;regions;rasterization;imaging;sampling;voronoi;poisson-disk</PackageTags>
		<RepositoryUrl>https://github.com/Akeldov/Akeldov.Math</RepositoryUrl>
		<PackageProjectUrl>https://akeldov.github.io/Akeldov.Math/Spatial2D/</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
