<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>9-recommended</AnalysisLevel>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Akeldov.Math.Hexes</PackageId>
		<Version>0.6.0</Version>
		<Authors>Stanislav Akeldov</Authors>
		<Copyright>Copyright (c) 2025 Stanislav Akeldov</Copyright>
		<Description>Hex-grid geometry, axial coordinates, topology, pathfinding, rasterization, chromatization, polyhex contours, and weighted Voronoi utilities.</Description>
		<PackageReleaseNotes>Added versioned HMAP binary serialization for Boolean, integer, and floating-point hex maps, including spatial variants that preserve origin and radius. BinaryWriter.Write overloads select the map format by the compile-time source type; matching readers validate headers, geometry, payloads, and optional cell-count limits. Float values preserve exact IEEE 754 bits. HexMapFile provides file reading and writing with absolute or relative paths and automatic resource disposal. The minimum Akeldov.Math.Spatial2D dependency remains 1.1.0, with compatible 1.x releases accepted.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>math;geometry;hex;hex-grid;vectors;topology;pathfinding;rasterization;voronoi;polyhex</PackageTags>
		<RepositoryUrl>https://github.com/Akeldov/Akeldov.Math</RepositoryUrl>
		<PackageProjectUrl>https://akeldov.github.io/Akeldov.Math/Hexes/</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Akeldov.Math.Spatial2D" Version="[1.1.0, 2.0.0)" />
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.124">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
