<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>9-recommended</AnalysisLevel>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Akeldov.Math.Hexes</PackageId>
		<Version>0.9.0</Version>
		<Authors>Stanislav Akeldov</Authors>
		<Copyright>Copyright (c) 2025 Stanislav Akeldov</Copyright>
		<Description>Hex-grid geometry, axial coordinates, topology, pathfinding, rasterization, chromatization, polyhex contours, Voronoi and Perlin-noise partitioning, and Cellular Potts diffusion.</Description>
		<PackageReleaseNotes>Added geometry-aware Perlin-noise partitioning with target area shares, participation and region masks; Cellular Potts diffusion with target areas, optional connectivity preservation, and region constraints; and SplitDisconnectedCells for full and partial partitions. Added Voronoi relaxation and immutable partition parameter objects. Breaking changes: ToVoronoiHexPartitionMap and ToPartialVoronoiHexPartitionMap are now PartitionByVoronoi; masks precede sites, and policies are configured through VoronoiHexPartitionParameters. PairPresenceFlags, TripletPresenceFlags, SeptupletPresenceFlags, and ChromaticTripletPresenceFlags are renamed without the Flags suffix. New partition APIs are PartitionByPerlinNoise and DiffuseByCellularPotts. Rebuild consumers and migrate old Voronoi calls and enum names. Targets remain netstandard2.1 and net6.0; the minimum Spatial2D dependency remains 1.1.0, with compatible 1.x releases accepted.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>math;geometry;hex;hex-grid;vectors;topology;pathfinding;rasterization;voronoi;polyhex</PackageTags>
		<RepositoryUrl>https://github.com/Akeldov/Akeldov.Math</RepositoryUrl>
		<PackageProjectUrl>https://akeldov.github.io/Akeldov.Math/Hexes/</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="Akeldov.Math.Hexes.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Akeldov.Math.Spatial2D" Version="[1.1.0, 2.0.0)" />
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.124">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
