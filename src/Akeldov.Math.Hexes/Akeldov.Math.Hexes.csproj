<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>9-recommended</AnalysisLevel>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Akeldov.Math.Hexes</PackageId>
		<Version>0.8.0</Version>
		<Authors>Stanislav Akeldov</Authors>
		<Copyright>Copyright (c) 2025 Stanislav Akeldov</Copyright>
		<Description>Hex-grid geometry, axial coordinates, topology, pathfinding, rasterization, chromatization, polyhex contours, and weighted Voronoi utilities.</Description>
		<PackageReleaseNotes>Added generic full and partial partition maps storing mutable int and nullable-int cell identifiers, nullable Voronoi region masks, and ExclavePolicy.ReassignToClosestCell. Added specialized-map operators with HexMap operands and constant-time shared-storage implicit conversions for spatial maps, center maps, and Voronoi partition maps. Breaking changes: MaskedVoronoiHexPartitionMap is now PartialVoronoiHexPartitionMap; VoronoiCell is now VoronoiHexPartitionCell; partial partition extensions are now ToPartialVoronoiHexPartitionMap; VoronoiHexPartitioner is internal. Specialized spatial maps now inherit their topology-only counterparts, and HexCenterMap inherits HexMap&lt;PointXY&gt;. Moved geometry and chromatization helpers to receiver-specific classes and HexVerticesHelpers. Explicit map and raster index guards now use informative ArgumentOutOfRangeException messages. Rebuild consumers and update partition indexer usage from cell objects to identifiers. The minimum Akeldov.Math.Spatial2D dependency remains 1.1.0, with compatible 1.x releases accepted.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>math;geometry;hex;hex-grid;vectors;topology;pathfinding;rasterization;voronoi;polyhex</PackageTags>
		<RepositoryUrl>https://github.com/Akeldov/Akeldov.Math</RepositoryUrl>
		<PackageProjectUrl>https://akeldov.github.io/Akeldov.Math/Hexes/</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="Akeldov.Math.Hexes.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Akeldov.Math.Spatial2D" Version="[1.1.0, 2.0.0)" />
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.124">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
