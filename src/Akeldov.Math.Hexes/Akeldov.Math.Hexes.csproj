<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>9-recommended</AnalysisLevel>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Akeldov.Math.Hexes</PackageId>
		<Version>0.10.0</Version>
		<Authors>Stanislav Akeldov</Authors>
		<Copyright>Copyright (c) 2025 Stanislav Akeldov</Copyright>
		<Description>Hex-grid geometry, axial coordinates, topology, pathfinding, rasterization, chromatization, polyhex contours, Voronoi and Perlin-noise partitioning, and Cellular Potts diffusion.</Description>
		<PackageReleaseNotes>Added SpatialHexPartitionMap and SpatialPartialHexPartitionMap, geometry-preserving SplitDisconnectedCells and Cellular Potts extensions, covariant IHexMap, and configurable outward polyhex region offsets via ToOffsetRegion. Breaking changes: full Voronoi partitions now return SpatialHexPartitionMap&lt;VoronoiHexPartitionCell&gt;; Perlin partitions now return SpatialHexPartitionMap&lt;HexPartitionCell&gt; or SpatialPartialHexPartitionMap&lt;HexPartitionCell&gt;. Removed VoronoiHexPartitionMap, PerlinNoiseHexPartitionMap, and PartialPerlinNoiseHexPartitionMap. Rebuild consumers and migrate explicit result types and removed full-Voronoi convenience members. Targets remain netstandard2.1 and net6.0; the minimum Spatial2D dependency remains 1.1.0.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>math;geometry;hex;hex-grid;vectors;topology;pathfinding;rasterization;voronoi;polyhex</PackageTags>
		<RepositoryUrl>https://github.com/Akeldov/Akeldov.Math</RepositoryUrl>
		<PackageProjectUrl>https://akeldov.github.io/Akeldov.Math/Hexes/</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="Akeldov.Math.Hexes.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Akeldov.Math.Spatial2D" Version="[1.1.0, 2.0.0)" />
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.124">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
