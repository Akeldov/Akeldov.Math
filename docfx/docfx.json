{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Akeldov.Math.Spatial2D/Akeldov.Math.Spatial2D.csproj"
          ]
        }
      ],
      "dest": "api/Spatial2D/latest",
      "properties": {
        "TargetFramework": "net6.0"
      }
    },
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Akeldov.Math.Hexes/Akeldov.Math.Hexes.csproj"
          ]
        }
      ],
      "dest": "api/Hexes/latest",
      "properties": {
        "TargetFramework": "net6.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "about.md",
          "toc.yml"
        ]
      },
      {
        "src": "Libraries",
        "files": [
          "**/*.{md,yml}"
        ],
        "dest": "Libraries"
      },
      {
        "src": "ru",
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "Spatial2D/**",
          "Hexes/**"
        ],
        "dest": "ru"
      },
      {
        "src": "ru/Spatial2D",
        "files": [
          "**/*.{md,yml}"
        ],
        "dest": "ru/Spatial2D/latest"
      },
      {
        "src": "ru/Hexes",
        "files": [
          "**/*.{md,yml}"
        ],
        "dest": "ru/Hexes/latest"
      },
      {
        "src": "api",
        "files": [
          "index.md",
          "toc.yml"
        ],
        "dest": "api"
      },
      {
        "src": "Spatial2D",
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "latest/api/**"
        ],
        "dest": "Spatial2D/latest"
      },
      {
        "src": "Hexes",
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "latest/api/**"
        ],
        "dest": "Hexes/latest"
      },
      {
        "src": "api/Spatial2D/latest",
        "files": [
          "**/*.yml"
        ],
        "dest": "api/Spatial2D/latest"
      },
      {
        "src": "api/Hexes/latest",
        "files": [
          "**/*.yml"
        ],
        "dest": "api/Hexes/latest"
      }
    ],
    "resource": [
      {
        "files": [
          "assets/**",
          "versions.json",
          "languages.json",
          "library-navigation.json",
          "robots.txt"
        ]
      },
      {
        "src": "Spatial2D",
        "files": [
          "versions.json",
          "index.html"
        ],
        "dest": "Spatial2D"
      },
      {
        "src": "Hexes",
        "files": [
          "versions.json",
          "index.html"
        ],
        "dest": "Hexes"
      }
    ],
    "output": "_site/Akeldov.Math",
    "sitemap": {
      "baseUrl": "https://akeldov.github.io/Akeldov.Math/",
      "changefreq": "weekly",
      "priority": 0.5
    },
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "Akeldov.Math",
      "_appTitle": "Akeldov.Math Documentation",
      "_appLogoPath": "assets/logo-akeldov.png",
      "_appFaviconPath": "assets/favicon-akeldov.png",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/Akeldov/Akeldov.Math",
        "branch": "main"
      }
    }
  }
}
