root = true

[*]
end_of_line = lf

[src/Akeldov.Math.Hexes/**/*.cs]
# CA1510: ArgumentNullException.ThrowIfNull is unavailable for netstandard2.1.
dotnet_diagnostic.CA1510.severity = none
# IDE0008: Use explicit type
csharp_style_var_when_type_is_apparent = false:none
# IDE0011: Add braces
csharp_prefer_braces = false
# IDE0022: Prefer expression bodies for single-line methods
csharp_style_expression_bodied_methods = when_on_single_line
# IDE0024: Use block body for operator
csharp_style_expression_bodied_operators = when_on_single_line
# IDE0032: Use auto property
dotnet_style_prefer_auto_properties = false
# IDE0046: Convert to conditional expression
dotnet_style_prefer_conditional_expression_over_return = false
# IDE0078: Use pattern matching
dotnet_diagnostic.IDE0078.severity = none
# IDE0090: Do not prefer target-typed new expressions.
csharp_style_implicit_object_creation_when_type_is_apparent = false
# IDE0130: Source folders organize files independently of public namespaces.
dotnet_style_namespace_match_folder = false

[src/Akeldov.Math.Spatial2D/**/*.cs]
# CA1510: ArgumentNullException.ThrowIfNull is unavailable for netstandard2.1.
dotnet_diagnostic.CA1510.severity = none
# IDE0008: Use explicit type
csharp_style_var_when_type_is_apparent = false:none
# IDE0011: Add braces
csharp_prefer_braces = false
# IDE0022: Prefer expression bodies for single-line methods
csharp_style_expression_bodied_methods = when_on_single_line
# IDE0024: Use block body for operator
csharp_style_expression_bodied_operators = when_on_single_line
# IDE0032: Use auto property
dotnet_style_prefer_auto_properties = false
# IDE0046: Convert to conditional expression
dotnet_style_prefer_conditional_expression_over_return = false
# IDE0078: Use pattern matching
dotnet_diagnostic.IDE0078.severity = none
# IDE0090: Do not prefer target-typed new expressions.
csharp_style_implicit_object_creation_when_type_is_apparent = false
# IDE0130: Source folders organize files independently of public namespaces.
dotnet_style_namespace_match_folder = false

[src/Akeldov.Math.Spatial3D/**/*.cs]
# CA1510: ArgumentNullException.ThrowIfNull is unavailable for netstandard2.1.
dotnet_diagnostic.CA1510.severity = none
